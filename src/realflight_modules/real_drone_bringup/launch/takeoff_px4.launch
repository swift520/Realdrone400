<launch>
  <arg name="fcu_url" default="/dev/ttyTHS0:921600" />
  <arg name="gcs_url" default="" />
  <arg name="tgt_system" default="1" />
  <arg name="tgt_component" default="1" />
  <arg name="enable_vision_bridge" default="true"
       doc="Start the FAST-LIO external-vision bridge and localization-health heartbeat. Set false when takeoff_vrpn.launch is started separately; exactly one bridge may run." />

  <!-- Start MAVROS for the onboard PX4 serial link. -->
  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)" />
    <arg name="gcs_url" value="$(arg gcs_url)" />
    <arg name="tgt_system" value="$(arg tgt_system)" />
    <arg name="tgt_component" value="$(arg tgt_component)" />
  </include>

  <group if="$(arg enable_vision_bridge)">
    <include file="$(find real_drone_bringup)/launch/takeoff_vrpn.launch" />
  </group>
</launch>
